############   CONCERN occurrences - Lock Receivers Timing with Individual Sturgeon History ###########

# --- Assumptions & Notes ---
# fuzzy_inner_join identifies detections occurring during lock‑open intervals.
# Only detections at Lock Receivers are considered for concern events.
# DF_overlap filters DF to only fish/dates where overlap occurred.
# Plots highlight potential fish‑lock interactions for reporting.


# Build lock operation intervals
lock_ops <- ll_final %>%
  dplyr::select(date = Date,
    lock_open  = LowerTainter.Opened,
    lock_close = LowerTainter.Closed) %>%
  filter(!is.na(lock_open), !is.na(lock_close))


# Filter detections INSIDE the lock (Lock Receivers only)
lock_dets <- DF %>%
  filter(receiver_location == "Lock Receivers",
         AFS %in% c("Atlantic Sturgeon", "Shortnose Sturgeon")) %>%
  dplyr::select(transmitter_label,  AFS,  detection_timestamp_est,  date, receiver_location)


# Temporal join: find detections that occurred during lock-open intervals
events <- fuzzy_inner_join(lock_dets, lock_ops, 
                           by = c( "detection_timestamp_est" = "lock_open","detection_timestamp_est" = "lock_close"),  
                           match_fun = list(`>=`, `<=`))



# Clean event table (optional but tidy)
events_clean <- events %>%
  mutate(event_id = paste(date.x, transmitter_label, sep = "_")) %>%
  dplyr::select(event_id,  transmitter_label,  AFS,  detection_timestamp_est,  lock_open,  lock_close,  date = date.x)



# Extract fish + date combinations where overlap occurred
overlap_keys <- events_clean %>%
  distinct(transmitter_label, date)

# Filter DF to only those fish + dates
DF_overlap <- DF %>%
  inner_join(overlap_keys, by = c("transmitter_label", "date"))


