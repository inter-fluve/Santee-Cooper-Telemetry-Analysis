                                    levels = c("Lock Receivers",
                                               "Lock Entrance Channel",
                                               "RKM 77",
                                               "RKM 76",
                                               "RKM 73"))) %>% 
      droplevels()
    
    if (nrow(df_pts) == 0) next
    
    species_name <- unique(df_pts$AFS)
    year_val <- unique(lubridate::year(df_pts$date))
    
    # ---- chunk dates into groups of 25 for pagination ----
    all_dates <- sort(unique(df_pts$date))
    date_chunks <- chunk_vec(all_dates, 25)
    n_pages <- length(date_chunks)
    
    for (page in seq_along(date_chunks)) {
      
      page_dates <- date_chunks[[page]]
      
      df_pts_page <- df_pts %>% filter(date %in% page_dates)
      df_pts_page$date <- factor(df_pts_page$date, levels = as.character(sort(page_dates)))
    
      
      # filter lock rectangles to dates for this fish/page
      ll_rect_sub <- ll_rect %>% filter(date %in% page_dates)
      
      p <- ggplot(df_pts_page, aes(x = hour_of_day, y = forcats::fct_rev(receiver_location2), color = receiver_location2)) +
        geom_point(alpha = 0.5, size = 2, position = position_jitter(height = 0.15)) +
