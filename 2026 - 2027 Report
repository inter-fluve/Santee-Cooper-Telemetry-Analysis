############   Lock Receivers Timing with Individual Sturgeon History ###########

# --- Assumptions & Notes ---
# "Abacus" plots show detections by hour of day, faceted by date.
# Lock rectangles (ll_rect) show tainter gate open intervals.
# panel_df shading shows lock broken vs operational; remove for future years.
# Font scaling is dynamic to handle fish with many detection days.
# This loop produces many plots; ggsave is commented out to avoid accidental mass export.

# ---- helper to chunk facets ----
chunk_vec <- function(x, n) {
  split(x, ceiling(seq_along(x) / n))
}
  
ids <- unique(DF$transmitter_label)
seasons <- unique(DF$Season)
save_folder <- "I:/Shared drives/IFI/Projects_Active/SanteeCooper_FERC_19-04-09/IFI_TASKS/Task_Y_SturgUseofLock/Data/Figures_Working/2026 - 2027 Report/"
counter <- 1

ll_rect <- ll_final %>%  
  mutate(date = as.Date(LowerTainter.Opened),
         xmin = hour(LowerTainter.Opened) + minute(LowerTainter.Opened)/60,
         xmax = hour(LowerTainter.Closed) + minute(LowerTainter.Closed)/60) %>%
  dplyr::select(date, xmin, xmax)



for (season in seasons) {
  for (id in ids) {
    df_pts <- DF %>%
      filter(AFS %in% c("Shortnose Sturgeon", "Atlantic Sturgeon"),
             transmitter_label == id,
             Season == season) %>%
      mutate(
        hour_of_day = lubridate::hour(detection_timestamp_est) +
