                  aes(xmin = xmin, xmax = xmax, ymin = -Inf, ymax = Inf),
                  fill = "grey30", alpha = 0.12, inherit.aes = FALSE) +
        facet_wrap(~date) +
        labs(
          title = paste0(season, " ", year_val, ": Detections for Transmitter ", id, " - ", species_name,
