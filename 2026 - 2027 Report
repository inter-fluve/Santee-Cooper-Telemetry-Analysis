          legend.title = element_text(size = font_size * 0.95),  # bumped up from 0.8
          plot.title  = element_text(size = font_size)
        )
      
      print(p)
      
      page_suffix <- if (n_pages > 1) paste0("_page", page) else ""
      file_name <- paste0(save_folder, "Abacus", counter, "_detections_with_locks_", season, "_", year_val, "_", id, "_", gsub(" ", "_", species_name), "_Page", page_suffix, ".jpeg")
       ggsave(filename = file_name, plot = p, width = plot_width, height = plot_height, units = "in", dpi = 300, limitsize = FALSE)
